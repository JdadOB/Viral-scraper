# Copy this file to .streamlit/secrets.toml and fill in your values.
# On Streamlit Cloud, set these in the app's Secrets settings panel instead.

APIFY_API_TOKEN       = "your_apify_api_token_here"
TIKTOK_ACTOR_ID       = "clockworks/tiktok-scraper"
INSTAGRAM_ACTOR_ID    = "apify/instagram-scraper"
MAX_RESULTS_PER_QUERY = 50
PROXY_ROTATION_ENABLED = true
CACHE_TTL_SECONDS     = 300
